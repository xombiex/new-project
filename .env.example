# Supabase project (Project Settings → API). Publishable key only — never the service_role/secret key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Optional overrides (defaults are free public services)
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# EXPO_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
# EXPO_PUBLIC_PHOTON_URL=https://photon.komoot.io

# In-app purchases (RevenueCat → Project → API keys → public app-specific keys)
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# Amazon Associates tracking id for the Gear screen (optional)
# EXPO_PUBLIC_AMAZON_TAG=yourtag-20
